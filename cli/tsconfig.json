{
  "compilerOptions": {
    "target": "ES2018",
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": "..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true,
    "lib": ["ES2018"],
    "baseUrl": ".",
    "paths": {
      "@echo.ai/schema": ["../src/schema/index.ts"]
    }
  },
  "include": ["src/**/*", "../src/schema/index.ts"],
  "exclude": ["node_modules", "dist"]
}